$APT "libs/wor/gui.wor";
$APT "libs/wor/colors.wor";
$APT "libs/wor/loops.wor";
$APT "libs/wor/debug.wor";

dbg_title("CHECKING ALL 16 LIBRARIES");

label_value("m_square(7)", m_square(7));
label_value("m_fact(6)", m_fact(6));
label_value("m_gcd(48,18)", m_gcd(48,18));
label_value("m_is_prime(17)", m_is_prime(17));
label_value("s_repeat", s_repeat("ab", 3));
say s_pad_left("42", 6) + "|";
say s_pad_right("42", 6) + "|";
say "r_int 1..6 = " + r_int(1, 6);
t_begin();
say "clock works: " + (t_elapsed() >= 0);
say "l_between(5,1,10) = " + l_between(5, 1, 10);
say "l_xor(1,0) = " + l_xor(1, 0);
say "st_med3(3,1,2) = " + st_med3(3, 1, 2);
say "st_pct(1,4) = " + st_pct(1, 4);
say "discount = " + mo_discount(100, 15);
say "energy = " + ph_energy(2, 3);
say "circle = " + geo_circle_area(1);
say "c2f(100) = " + cv_c2f(100);
say "key esc = " + KEY_ESC;
say "C_BLUE = " + C_BLUE;
say "lp_sum(10) = " + lp_sum(10);
dbg_assert_eq(m_cube(3), 27, "cube");
dbg_assert(1, "assertion");
s_banner("DONE");
