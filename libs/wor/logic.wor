// logic.wor — logic helpers
func l_between(x, lo, hi) { if x >= lo and x <= hi { give 1; } give 0; }
func l_xor(a, b) {
    if a { if !b { give 1; } } else { if b { give 1; } }
    give 0;
}
func l_nand(a, b) { if a and b { give 0; } give 1; }
func l_implies(a, b) { if a { give b; } give 1; }
func l_choose(cond, a, b) { if cond { give a; } give b; }
