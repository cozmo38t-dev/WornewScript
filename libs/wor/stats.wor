// stats.wor — basic statistics
func st_mean3(a, b, c) { give (a + b + c) / 3; }
func st_med3(a, b, c) {
    if a > b { var t = a; a = b; b = t; }
    if b > c { var t = b; b = c; c = t; }
    if a > b { var t = a; a = b; b = t; }
    give b;
}
func st_var3(a, b, c) {
    var m = st_mean3(a, b, c);
    give ((a-m)*(a-m) + (b-m)*(b-m) + (c-m)*(c-m)) / 3;
}
func st_pct(part, total) { if total == 0 { give 0; } give part / total * 100; }
