$APT "libs/col.c";
$APT "libs/control.c";
$APT "libs/cwc.c";
$APT "libs/dlc.c";
$APT "libs/io.c";
$APT "libs/keyboard.c";
$APT "libs/math.c";
$APT "libs/randnum.c";
$APT "libs/sysfile.c";
$APT "libs/time.c";
$APT "libs/winapi.c";
$APT "libs/string.c";
$APT "libs/stats.c";
$APT "libs/money.c";
$APT "libs/physics.c";
$APT "libs/geometry.c";

say "col: " + c_rgb(1, 2, 3) + " " + c_gray(7);
say "control: " + c_clamp(15, 0, 10) + " " + c_between(5, 1, 10);
say "cwc: " + c_c2f(100) + " " + c_f2c(212);
say "io: " + c_sum2(2, 3) + " " + c_sign(-4);
say "keyboard: " + c_key_esc() + " " + c_key_enter();
say "math: " + c_square(9) + " " + c_gcd(48, 18) + " " + c_fact(6);
say "sysfile: " + c_exists("test_c_libs.wor") + " " + c_is_abs("/tmp/x") + " " + c_is_abs("relative");
say "string: " + c_strlen("hello") + " " + c_padlen("hi", 5);
say "stats: " + c_mean3(1, 2, 6) + " " + c_med3(3, 1, 2);
say "money: " + c_discount(200, 25) + " " + c_vat(100, 20);
say "physics: " + c_force(2, 3) + " " + c_fall(2);
say "geometry: " + c_circle_area(1) + " " + c_dist(0, 0, 3, 4);
say "rand: " + c_randint(1, 6) + " " + c_randrange(0, 1);
say "time: " + c_ticks() + " " + c_elapsed(0);
say "done";
